i)By using Push button
//LED with Push button:
#define LED_PIN 8
#define BUTTON_PIN 7
void setup() {
pinMode(LED_PIN, OUTPUT);
pinMode(BUTTON_PIN, INPUT);
}
void loop() {
if (digitalRead(BUTTON_PIN) == HIGH) {
digitalWrite(LED_PIN, LOW);
}
else {
digitalWrite(LED_PIN, HIGH);
}
}

ii)By using IR sensor
// Arduino IR Sensor Code
const int ProxSensor=A0;
int inputVal = 0;
void setup()
{
pinMode(13, OUTPUT);
// Pin 13 has an LED connected on most Arduino boards:
pinMode(ProxSensor,INPUT); //Pin 2 is connected to the output of proximity sensor
Serial.begin(9600);
}
void loop()
{
if(digitalRead(ProxSensor)==HIGH)
{
digitalWrite(13, HIGH); // set the LED on
//Check the sensor output
}
else
{
digitalWrite(13, LOW); // set the LED off
}
inputVal = analogRead(ProxSensor);
Serial.println(inputVal);
delay(1000);
// wait for a second
}
