// Arduino Program to Interface a Soil Moisture Sensor
// Define the pin where the sensor is connected
const int sensorPin = A1; // Analog pin A1 for the soil moisture sensor
const int ledPin = 13; // Digital pin 13 for an alert LED (optional)
// Define moisture threshold values
const int dryThreshold = 600; // Higher values indicate dry soil
const int wetThreshold = 300; // Lower values indicate wet soil
void setup() {
// Initialize the serial communication
Serial.begin(9600);
// Set the LED pin as output
pinMode(ledPin, OUTPUT);
Serial.println("Soil Moisture Sensor Test Starting...");
}
void loop() {
// Read the sensor value
int sensorValue = analogRead(sensorPin);
// Print the sensor value for debugging
Serial.print("Soil Moisture Level: ");
Serial.println(sensorValue);
// Check soil moisture levels and take action
if (sensorValue > dryThreshold) {
Serial.println("Soil is dry. Watering required.");
digitalWrite(ledPin, HIGH); // Turn on the LED as an alert
} else if (sensorValue < wetThreshold) {
Serial.println("Soil is adequately wet.");
digitalWrite(ledPin, LOW); // Turn off the LED
} else {
Serial.println("Soil moisture is moderate.");
digitalWrite(ledPin, LOW);
}
// Wait for a short duration before the next reading
delay(1000);
}
// Interfacing Arduino uno with LDR sensor
const int ledPin = 5; // digital pin 5
const int ldrPin = A0; // analog pin 0
void setup()
{ // The setup() function will only run once, after each powerup or reset of the Arduino board. Serial.begin(9600);
pinMode(ledPin, OUTPUT); // Here LED is determined as an output or an indicator. pinMode(ldrPin, INPUT); // Here LDR sensor is determined as input. }
void loop()
{ // Void loop is ran again and again and contains main code. int ldrStatus = analogRead(ldrPin);
if (ldrStatus <= 200)
{
digitalWrite(ledPin, HIGH); // If LDR senses darkness led pin high that means led will glow. Serial.print("Darkness over here,turn on the LED :");
Serial.println(ldrStatus);
}
Else
{
digitalWrite(ledPin, LOW); // If LDR senses light led pin low that means led will stop glowing. Serial.print("There is sufficient light , turn off the LED : ");
Serial.println(ldrStatus);
}
}
